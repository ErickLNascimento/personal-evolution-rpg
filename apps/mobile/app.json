{
  "expo": {
    "name": "Personal Evolution RPG",
    "slug": "personal-evolution-rpg",
    "scheme": "evolutionrpg",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101116",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.erick.personalevolutionrpg",
      "infoPlist": {}
    },
    "android": {
      "package": "com.erick.personalevolutionrpg",
      "adaptiveIcon": {
        "backgroundColor": "#101116",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a1d627b6-40fb-4fe8-b662-50e961f53be0"
      }
    },
    "owner": "ericklnascimento",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a1d627b6-40fb-4fe8-b662-50e961f53be0"
    }
  }
}
